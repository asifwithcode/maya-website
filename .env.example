# Website database: Postgres 16 on our VPS (container maya-webdb, /opt/maya/webdb), TLS 1.3 only.
# Orders, stock, editions, prices and site copy live here. sslmode=verify-full pins the MAYA CA
# (src/db/ca.ts). The password is in /opt/maya/webdb/.env on the VPS (WEB_DB_PASSWORD).
DATABASE_URL="postgresql://maya_web:PASSWORD@api.themaya.site:5433/maya_web?sslmode=verify-full"

# Admin token. /admin (login screen) and /api/web-admin use it as "Authorization: Bearer <token>".
# Both are CLOSED on production builds unless this is set. On the local dev server (npm run dev)
# the API is open without a token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_ADMIN_TOKEN=

# Google Search Console "HTML tag" verification (only the content="..." value). Optional if you verify by DNS.
GOOGLE_SITE_VERIFICATION=
