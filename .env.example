# Neon Postgres connection string (Neon dashboard -> Connection details).
# Orders, editions, prices and site copy live here. Set it in the hosting provider's env settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Optional. /api/web-admin (orders + CMS for MAYA Studio) is CLOSED on production builds unless
# this is set; then requests must send "Authorization: Bearer <token>". On the local dev server
# (npm run dev) it is open without a token, which is how MAYA Studio uses it today.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_ADMIN_TOKEN=
