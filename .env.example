# Neon Postgres connection string (Neon dashboard -> Connection details)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Password for /admin
ADMIN_PASSWORD="change-me"
# Random 64-char hex used to sign the admin session cookie
ADMIN_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# Where /app downloads the Android app from (a signed release APK). Leave empty to show "coming soon".
MAYA_APK_URL=""
# Shown under the download button, e.g. "1.0"
MAYA_APK_VERSION=""
